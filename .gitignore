# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Environments
.env
.venv
env/
venv/
ENV/

# Pytest / Coverage
.pytest_cache/
.coverage
htmlcov/

# PyTorch / Models
*.pt
*.pth
*.bin
*.onnx
# Exception: allow small test checkpoints if committed under tests/fixtures
!tests/fixtures/*.pt

# Large Generated Datasets (keep small smoke tests if needed)
data/generated/*
!data/generated/smoke_test/
!data/generated/sample_smoke/
data/corpora/*.raw
data/documents/*.large
data/sunrgbd/*
!data/sunrgbd/manifest.json
!data/sunrgbd/sample_smoke/
*.mat
*.zip


# Results and Cache
scratch/
results/plots/*.png
results/predictions/*
!results/plots/.gitkeep
!results/predictions/.gitkeep
!results/metrics/.gitkeep

# Unity generated folders
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
MemoryCaptures/
*.pidb.meta
*.pdb.meta
*.opendb
*.VC.db

# Unity project-specific
unity/SpatialAIUnity/Library/
unity/SpatialAIUnity/Temp/
unity/SpatialAIUnity/Logs/
unity/SpatialAIUnity/Build/
unity/SpatialAIUnity/UserSettings/

