# Spatial Quest — Environment Configuration Template
# Copy this file to `.env` and fill in your server-side Gemini API key.
# NEVER commit `.env` or expose your API key in frontend JavaScript.

# Google Gemini API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Supported Gemini model for conversation & tool calling
# Recommended: gemini-2.5-flash (auto-fallback: gemini-2.5-flash-lite, gemini-3-flash-preview)
GEMINI_MODEL=gemini-2.5-flash

# Language model backend mode ("gemini_api" or "from_scratch")
# When GEMINI_API_KEY is configured, gemini_api is used automatically.
SPATIAL_LLM_MODE=gemini_api

# Request timeout (seconds) for server-side Gemini calls
GEMINI_TIMEOUT_SECONDS=15.0

